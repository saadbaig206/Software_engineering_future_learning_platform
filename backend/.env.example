# FutureLearning Environment Variables Template

# 1. Django Backend Configuration
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret-key-32chars
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# 2. Neon PostgreSQL Connection Strings
# Runtime connection (Use pooled connection endpoint for normal application web queries)
DATABASE_URL=postgresql://user:password@ep-ancient-wildflower-b3hehj34-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Migration connection (Use direct connection endpoint without pooler for schema migrations)
DIRECT_DATABASE_URL=postgresql://user:password@ep-ancient-wildflower-b3hehj34.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 3. Redis In-Memory Cache & Celery Task Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 4. S3-Compatible Object Storage (Provider-Agnostic: AWS S3, Cloudflare R2, MinIO)
USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=futurelearning-media
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 5. SimpleJWT Token Security
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
